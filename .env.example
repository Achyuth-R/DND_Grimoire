# Shared character storage (optional). Copy to .env.local for local dev, and add the
# same two variables in Vercel → Project → Settings → Environment Variables.
# Find both in Supabase → Project Settings → API. Leave unset to keep characters local-only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
